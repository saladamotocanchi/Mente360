/* =========================================================
   MENTE360 — DISEÑO VISUAL
   Inspirado en la referencia proporcionada
   ========================================================= */

:root {
  --bg: #fff8fc;
  --white: #ffffff;
  --purple: #7561d8;
  --purple-dark: #51439d;
  --lavender: #e9e4ff;
  --pink: #f8c7df;
  --pink-soft: #fff0f7;
  --blue: #cfeaf8;
  --green: #d5f1df;
  --yellow: #fcebc0;
  --text: #30345d;
  --muted: #747793;
  --border: #e7e1f2;
  --shadow: 0 10px 30px rgba(102, 80, 150, 0.10);
  --radius: 24px;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  min-width: 320px;
  background:
    radial-gradient(circle at 5% 5%, rgba(248, 199, 223, .35), transparent 25%),
    radial-gradient(circle at 95% 15%, rgba(207, 234, 248, .38), transparent 25%),
    var(--bg);
  color: var(--text);
  font-family:
    "Nunito",
    "Poppins",
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;
}

/* =========================================================
   APP
   ========================================================= */

.app-shell {
  min-height: 100vh;
  display: flex;
  background: var(--bg);
}

/* =========================================================
   SIDEBAR
   ========================================================= */

.sidebar {
  position: fixed;
  left: 0;
  top: 0;
  bottom: 0;
  width: 250px;
  padding: 24px 16px;
  background: rgba(255, 255, 255, .94);
  border-right: 1px solid var(--border);
  z-index: 50;
  overflow-y: auto;
}

.sidebar-logo {
  margin-bottom: 28px;
}

.sidebar nav {
  display: flex;
  flex-direction: column;
  gap: 7px;
}

.sidebar button,
.sidebar a {
  width: 100%;
  min-height: 48px;
  padding: 11px 14px;
  display: flex;
  align-items: center;
  gap: 12px;
  border: 0;
  border-radius: 16px;
  background: transparent;
  color: #696b86;
  font-size: 14px;
  font-weight: 800;
  text-align: left;
  cursor: pointer;
  transition: .22s ease;
}

.sidebar button:hover,
.sidebar a:hover {
  background: #f5f0ff;
  color: var(--purple);
  transform: translateX(3px);
}

.sidebar button.active,
.sidebar a.active {
  background: linear-gradient(135deg, #e7e1ff, #f5e9ff);
  color: var(--purple-dark);
  box-shadow: 0 5px 18px rgba(117, 97, 216, .10);
}

.sidebar button svg,
.sidebar a svg {
  flex-shrink: 0;
}

/* =========================================================
   CONTENIDO
   ========================================================= */

.main-content,
main {
  width: calc(100% - 250px);
  margin-left: 250px;
  padding: 26px 34px 50px;
}

/* =========================================================
   TOPBAR
   ========================================================= */

.topbar {
  height: 64px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 22px;
}

.search-box {
  width: min(430px, 100%);
  height: 46px;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 0 16px;
  background: white;
  border: 1px solid var(--border);
  border-radius: 18px;
  box-shadow: var(--shadow);
}

.search-box input {
  width: 100%;
  border: 0;
  outline: 0;
  background: transparent;
  color: var(--text);
  font-size: 14px;
}

.profile-button {
  border: 0;
  background: white;
  border-radius: 50%;
  cursor: pointer;
}

/* =========================================================
   HERO — MUY PARECIDO A LA REFERENCIA
   ========================================================= */

.hero {
  position: relative;
  min-height: 250px;
  display: grid;
  grid-template-columns: 1.25fr .75fr .8fr;
  align-items: center;
  gap: 20px;
  padding: 30px 34px;
  margin-bottom: 25px;
  overflow: hidden;
  border-radius: 32px;
  background:
    radial-gradient(circle at 12% 20%, rgba(248, 199, 223, .65), transparent 30%),
    radial-gradient(circle at 90% 20%, rgba(207, 234, 248, .65), transparent 32%),
    linear-gradient(135deg, #fff1f8, #f1efff 52%, #eaf7ff);
  border: 1px solid #eee5f7;
  box-shadow: var(--shadow);
}

.hero::before,
.hero::after {
  content: "";
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.hero::before {
  width: 180px;
  height: 180px;
  left: -70px;
  bottom: -100px;
  background: rgba(222, 213, 255, .65);
}

.hero::after {
  width: 150px;
  height: 150px;
  right: -60px;
  bottom: -70px;
  background: rgba(207, 234, 248, .7);
}

.hero-copy {
  position: relative;
  z-index: 2;
}

.hero-copy h1 {
  margin: 0;
  font-size: clamp(44px, 5vw, 72px);
  line-height: .9;
  font-weight: 1000;
  letter-spacing: -3px;
  color: #51439d;
}

.hero-copy h1 span {
  color: #e77aa8;
}

.hero-copy p {
  margin: 14px 0 0;
  max-width: 470px;
  font-size: 17px;
  line-height: 1.5;
  font-weight: 800;
  color: #4c4f75;
}

.sparkles {
  margin-bottom: 5px;
  color: #927fdf;
  font-size: 20px;
}

.heart-line {
  margin-top: 16px;
  color: #7464c8;
  font-size: 18px;
  font-weight: 900;
}

.hero-brain {
  position: relative;
  min-height: 180px;
  display: flex;
  justify-content: center;
  align-items: center;
}

.brain-face {
  position: relative;
  width: 135px;
  height: 135px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 42% 58% 45% 55%;
  background: linear-gradient(135deg, #f5c5df, #bcd8f8);
  border: 7px solid rgba(255,255,255,.8);
  box-shadow: 0 15px 30px rgba(104, 83, 160, .18);
  font-size: 72px;
}

.brain-heart {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 35px;
  height: 35px;
  transform: translate(-50%, -50%);
  color: #6555bd;
}

.orbit {
  position: absolute;
  width: 190px;
  height: 80px;
  border: 3px solid #8a7bd5;
  border-left-color: transparent;
  border-right-color: transparent;
  border-radius: 50%;
  transform: rotate(-12deg);
  color: #8a7bd5;
  font-size: 25px;
}

.hero-bubble {
  position: relative;
  z-index: 2;
  min-height: 150px;
  padding: 25px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  border-radius: 28px;
  background: rgba(255,255,255,.57);
  border: 1px solid rgba(255,255,255,.85);
  backdrop-filter: blur(8px);
}

.hero-bubble strong {
  font-size: 22px;
  line-height: 1.25;
  color: #4e4c78;
}

.hero-bubble span {
  margin-top: 10px;
  font-size: 25px;
  color: #e27ba9;
}

/* =========================================================
   SECCIÓN EMOCIONES
   ========================================================= */

.mood-section {
  padding: 25px;
  margin-bottom: 28px;
  background: rgba(255,255,255,.9);
  border: 1px solid var(--border);
  border-radius: 28px;
  box-shadow: var(--shadow);
}

.section-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  margin-bottom: 20px;
}

.section-heading h2 {
  margin: 0;
  font-size: 25px;
  font-weight: 1000;
  color: var(--purple-dark);
}

.section-heading p {
  margin: 5px 0 0;
  color: var(--muted);
  font-size: 13px;
  font-weight: 700;
}

.outline-button {
  height: 44px;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 0 16px;
  border: 1px solid #d9d0f4;
  border-radius: 15px;
  background: #faf8ff;
  color: var(--purple);
  font-weight: 900;
  cursor: pointer;
}

.moods {
  display: grid;
  grid-template-columns: repeat(9, 1fr);
  gap: 10px;
}

.mood {
  min-height: 92px;
  padding: 12px 6px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 7px;
  border: 2px solid transparent;
  border-radius: 20px;
  cursor: pointer;
  transition: .2s ease;
  color: var(--text);
}

.mood:hover {
  transform: translateY(-4px);
}

.mood.selected {
  border-color: var(--purple);
  transform: translateY(-3px);
  box-shadow: 0 8px 20px rgba(117,97,216,.15);
}

.mood span {
  width: 43px;
  height: 43px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  font-size: 23px;
}

.mood b {
  font-size: 11px;
  text-align: center;
}

.mood.pink {
  background: #fff0f6;
}

.mood.blue {
  background: #edf8ff;
}

.mood.yellow {
  background: #fff8df;
}

.mood.green {
  background: #edf9f0;
}

.mood.purple {
  background: #f1efff;
}

.mood-message {
  margin-top: 15px;
  padding: 13px 17px;
  border-radius: 15px;
  background: #f5f1ff;
  color: #6658a9;
  font-size: 13px;
  font-weight: 700;
}

/* =========================================================
   HERRAMIENTAS
   ========================================================= */

.tools-section {
  padding: 10px 0;
}

.title-decor {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 15px;
  margin: 18px 0 22px;
}

.title-decor h2 {
  margin: 0;
  color: #51439d;
  font-size: 27px;
  font-weight: 1000;
}

.title-decor span {
  color: #e17ca9;
  font-size: 23px;
}

.tools-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16px;
}

.tool-card {
  position: relative;
  min-height: 155px;
  padding: 20px;
  display: flex;
  align-items: center;
  gap: 15px;
  overflow: hidden;
  border: 1px solid rgba(130, 110, 170, .10);
  border-radius: 25px;
  cursor: pointer;
  text-align: left;
  box-shadow: 0 8px 22px rgba(80, 70, 120, .07);
  transition:
    transform .2s ease,
    box-shadow .2s ease,
    border-color .2s ease;
}

.tool-card::after {
  content: "›";
  position: absolute;
  right: 17px;
  bottom: 13px;
  font-size: 25px;
  font-weight: 900;
  opacity: .5;
}

.tool-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 15px 32px rgba(80, 70, 120, .13);
  border-color: rgba(117, 97, 216, .25);
}

.tool-icon {
  width: 58px;
  height: 58px;
  min-width: 58px;
  display: grid;
  place-items: center;
  border-radius: 19px;
  background: rgba(255,255,255,.68);
  color: #6456b9;
  box-shadow: 0 5px 15px rgba(80,70,120,.07);
}

.tool-text {
  min-width: 0;
  padding-right: 15px;
}

.tool-text h3 {
  margin: 0 0 6px;
  color: #4d4e72;
  font-size: 15px;
  line-height: 1.2;
  font-weight: 1000;
}

.tool-text p {
  margin: 0;
  color: #777991;
  font-size: 11px;
  line-height: 1.4;
  font-weight: 700;
}

/* COLORES DE LAS 11 TARJETAS */

.tool-card.pink {
  background: linear-gradient(135deg, #fff0f7, #ffe5f0);
}

.tool-card.purple {
  background: linear-gradient(135deg, #f0edff, #e6e0ff);
}

.tool-card.blue {
  background: linear-gradient(135deg, #edf9ff, #dff2fb);
}

.tool-card.green {
  background: linear-gradient(135deg, #effbf2, #dff4e6);
}

.tool-card.yellow {
  background: linear-gradient(135deg, #fff9e9, #ffefc6);
}

.tool-card.lavender {
  background: linear-gradient(135deg, #f4f1ff, #e9e4ff);
}

/* =========================================================
   SECCIONES INTERNAS
   ========================================================= */

.section-page {
  width: 100%;
  max-width: 1100px;
  margin: 0 auto;
  padding: 10px 0 50px;
}

.section-page-header {
  position: relative;
  padding: 35px;
  margin-bottom: 22px;
  overflow: hidden;
  border-radius: 30px;
  background:
    linear-gradient(135deg, #f8efff, #fff0f7 50%, #eaf7ff);
  border: 1px solid var(--border);
  box-shadow: var(--shadow);
}

.section-page-header h1 {
  margin: 12px 0 8px;
  color: #51439d;
  font-size: 34px;
  font-weight: 1000;
}

.section-page-header p {
  max-width: 700px;
  margin: 0;
  color: #6e718b;
  font-size: 14px;
  line-height: 1.6;
  font-weight: 700;
}

.section-back-button {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 10px 15px;
  border: 0;
  border-radius: 14px;
  background: white;
  color: var(--purple);
  font-weight: 900;
  cursor: pointer;
  box-shadow: 0 5px 15px rgba(70,60,120,.08);
}

.section-info-card {
  padding: 24px;
  margin-bottom: 15px;
  border-radius: 23px;
  background: white;
  border: 1px solid var(--border);
  box-shadow: 0 8px 24px rgba(70,60,120,.06);
}

.section-info-card h3 {
  margin: 0 0 7px;
  color: #51439d;
  font-size: 17px;
  font-weight: 1000;
}

.section-info-card p {
  margin: 0;
  color: #73768e;
  line-height: 1.65;
  font-size: 13px;
}

/* =========================================================
   LOGO
   ========================================================= */

.logo,
.logo-container {
  display: flex;
  align-items: center;
  gap: 10px;
}

.logo img,
.logo-container img {
  width: 48px;
  height: 48px;
  object-fit: contain;
}

.logo-text {
  color: #51439d;
  font-size: 22px;
  font-weight: 1000;
}

.logo-text span {
  color: #e67ca9;
}

/* =========================================================
   MOBILE NAV
   ========================================================= */

.mobile-nav {
  display: none;
}

/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 1200px) {
  .tools-grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .moods {
    grid-template-columns: repeat(5, 1fr);
  }

  .hero {
    grid-template-columns: 1.2fr .8fr;
  }

  .hero-bubble {
    display: none;
  }
}

@media (max-width: 900px) {
  .sidebar {
    width: 220px;
  }

  .main-content,
  main {
    width: calc(100% - 220px);
    margin-left: 220px;
    padding: 20px;
  }

  .tools-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .hero {
    min-height: 230px;
  }
}

@media (max-width: 700px) {
  .sidebar {
    transform: translateX(-105%);
    transition: transform .25s ease;
    width: 280px;
    box-shadow: 10px 0 30px rgba(70,60,120,.12);
  }

  .sidebar.open {
    transform: translateX(0);
  }

  .main-content,
  main {
    width: 100%;
    margin-left: 0;
    padding: 14px 13px 90px;
  }

  .topbar {
    height: 52px;
    margin-bottom: 13px;
  }

  .search-box {
    width: 100%;
  }

  .hero {
    grid-template-columns: 1fr;
    min-height: auto;
    padding: 27px 20px;
    border-radius: 27px;
    text-align: center;
  }

  .hero-copy h1 {
    font-size: 52px;
  }

  .hero-copy p {
    margin-left: auto;
    margin-right: auto;
    font-size: 14px;
  }

  .hero-brain {
    min-height: 155px;
  }

  .mood-section {
    padding: 18px 14px;
    border-radius: 23px;
  }

  .section-heading {
    flex-direction: column;
    align-items: flex-start;
  }

  .outline-button {
    width: 100%;
    justify-content: center;
  }

  .moods {
    grid-template-columns: repeat(3, 1fr);
  }

  .mood {
    min-height: 82px;
  }

  .tools-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 11px;
  }

  .tool-card {
    min-height: 145px;
    padding: 15px 12px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    border-radius: 21px;
  }

  .tool-text {
    padding-right: 0;
  }

  .tool-text h3 {
    font-size: 12px;
  }

  .tool-text p {
    font-size: 10px;
  }

  .tool-icon {
    width: 52px;
    height: 52px;
    min-width: 52px;
  }

  .tool-card::after {
    right: 9px;
    bottom: 5px;
    font-size: 19px;
  }

  .mobile-nav {
    position: fixed;
    left: 10px;
    right: 10px;
    bottom: 10px;
    height: 66px;
    display: flex;
    align-items: center;
    justify-content: space-around;
    gap: 5px;
    padding: 6px;
    z-index: 100;
    border: 1px solid #e4ddf0;
    border-radius: 23px;
    background: rgba(255,255,255,.94);
    backdrop-filter: blur(15px);
    box-shadow: 0 10px 30px rgba(70,60,120,.16);
  }

  .mobile-nav button {
    min-width: 60px;
    height: 54px;
    border: 0;
    border-radius: 17px;
    background: transparent;
    color: #777991;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    font-size: 9px;
    font-weight: 900;
    cursor: pointer;
  }

  .mobile-nav button.active {
    background: #eee9ff;
    color: #6455b7;
  }

  .section-page {
    padding-bottom: 25px;
  }

  .section-page-header {
    padding: 23px 18px;
    border-radius: 24px;
  }

  .section-page-header h1 {
    font-size: 28px;
  }
}

@media (max-width: 430px) {
  .tools-grid {
    gap: 8px;
  }

  .tool-card {
    min-height: 138px;
    padding: 12px 7px;
  }

  .tool-icon {
    width: 46px;
    height: 46px;
    min-width: 46px;
  }

  .tool-text h3 {
    font-size: 11px;
  }

  .tool-text p {
    font-size: 9px;
  }

  .hero-copy h1 {
    font-size: 46px;
  }

  .moods {
    gap: 7px;
  }

  .mood span {
    width: 38px;
    height: 38px;
    font-size: 20px;
  }

  .mood b {
    font-size: 10px;
  }
}

/* =========================================================
   ANIMACIONES SUAVES
   ========================================================= */

@keyframes floatMente {
  0%, 100% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(-7px);
  }
}

.brain-face {
  animation: floatMente 4s ease-in-out infinite;
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation: none !important;
    transition: none !important;
  }
}